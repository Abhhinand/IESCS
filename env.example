# Groq API key - get one free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Groq model to use for the triage agent
GROQ_MODEL=llama-3.3-70b-versatile

# Base URL the honeytoken canary links point back to.
# Leave this BLANK/commented out to auto-detect your machine's local
# network IP - this makes canary URLs work from your phone or any other
# device on the same WiFi automatically, with no manual setup.
# Set it explicitly to override, e.g.:
#   CALLBACK_BASE_URL=http://localhost:8000              (this machine only)
#   CALLBACK_BASE_URL=https://<your-ngrok-subdomain>.ngrok-free.app  (public internet)
# CALLBACK_BASE_URL=

# URL the Streamlit dashboard uses to reach the FastAPI backend
API_BASE_URL=http://localhost:8000
