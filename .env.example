# Groq API key - get one free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Groq model to use for the triage agent
GROQ_MODEL=llama-3.3-70b-versatile

# Base URL the honeytoken canary links point back to.
# Local dev: http://localhost:8000
# Public demo via ngrok: https://<your-ngrok-subdomain>.ngrok-free.app
CALLBACK_BASE_URL=http://localhost:8000

# URL the Streamlit dashboard uses to reach the FastAPI backend
API_BASE_URL=http://localhost:8000
